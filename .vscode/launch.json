{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32F411 (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/STM32F411_Project.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "arm-none-eabi-gdb",
            "preLaunchTask": "1. Build (Make)"
        }
    ]
}