{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Build (Make)",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "2. Clean (Make clean)",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "3. Flash (OpenOCD)",
            "type": "shell",
            "command": "openocd -f interface/stlink.cfg -f target/stm32f4x.cfg -c \"program build/STM32F411_Project.elf verify reset exit\"",
            "problemMatcher": []
        }
    ]
}